// UMN Table Tennis Club - membership & purchases
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Catalog

enum ProductKind {
  YEAR_MEMBERSHIP
  FALL_MEMBERSHIP
  LEAGUE_DROPIN
  OPENPLAY_DROPIN
  TRAINING
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  kind         ProductKind
  nameEn       String
  nameZh       String
  descEn       String
  descZh       String
  // Null means "price to be announced" - the product renders but cannot be bought.
  priceCents   Int?
  requiresDate Boolean     @default(false)
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)

  orders Order[]
}

// ---------------------------------------------------------------- Commerce

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  PAYPAL
  STRIPE
  // Settled by a promo code that brought the total to zero - no processor involved.
  PROMO
}

model Order {
  id        String @id @default(cuid())
  productId String

  // The buyer, captured on the product page. There are no accounts, so this is the only
  // record of who bought - self-asserted and never verified.
  buyerName  String
  buyerEmail String
  // Self-assessed, asked only for dated day passes so the club can seed a new player into
  // roughly the right group. Optional: returning members skip it.
  skillLevel SkillLevel?

  status        OrderStatus      @default(PENDING)
  amountCents   Int
  currency      String           @default("USD")
  provider      PaymentProvider?
  // Provider's own id (PayPal order id / Stripe PaymentIntent id). Unique so that a
  // capture response and a webhook for the same payment cannot both fulfil it.
  providerRef   String?          @unique
  // Chosen session date for drop-in products; null for memberships.
  eventDate     DateTime?
  // The promo code applied, if any, and what it took off. Kept on the order so the
  // club's records show why someone paid less than list price.
  promoCode     String?
  discountCents Int              @default(0)
  fulfilledAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  membership Membership?

  @@index([buyerEmail])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MembershipTier {
  YEAR
  FALL
}

model Membership {
  id        String         @id @default(cuid())
  tier      MembershipTier
  startsAt  DateTime
  endsAt    DateTime
  orderId   String         @unique
  createdAt DateTime       @default(now())

  // The buyer is read through the order - there is no account to point at.
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
