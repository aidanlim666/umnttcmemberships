# ---------------------------------------------------------------- Database
# Local dev Postgres (docker run ... postgres:16 on port 5433 — see README).
DATABASE_URL="postgresql://user:password@host:5432/umnttc?schema=public"

# ---------------------------------------------------------------- PayPal (+ Venmo)
# Sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ---------------------------------------------------------------- Stripe (Apple Pay + cards)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------- Google Sheets purchase log
# Optional. When unset, purchases are logged to the server console instead.
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ---------------------------------------------------------------- Email (SMTP)
# Used for signup confirmation codes and password resets.
# Optional. When unset, codes are printed to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="UMN Table Tennis Club <no-reply@example.com>"
